"""Self-contained NAS-Bench-201 model; architecture choices are fixed in source.

Reference: D-X-Y/AutoDL-Projects, revision ${source_revision}.
The model requires only PyTorch. It returns (pooled_features, logits).
"""

import torch
import torch.nn as nn


ARCH_INDEX = ${arch_index}
ARCHITECTURE = "${arch_str}"


class ReLUConvBN(nn.Module):
    def __init__(self, in_channels, out_channels, kernel_size, stride, padding):
        super().__init__()
        # 保留官方普通卷积的 ReLU、无偏置卷积和 BatchNorm 顺序。
        self.op = nn.Sequential(
            nn.ReLU(inplace=False),
            nn.Conv2d(in_channels, out_channels, kernel_size, stride, padding, bias=False),
            nn.BatchNorm2d(out_channels),
        )

    def forward(self, inputs):
        output = self.op(inputs)
        return output


class Zero(nn.Module):
    def __init__(self):
        super().__init__()

    def forward(self, inputs):
        # 同通道、步长为 1 的 none 保留官方乘零操作，不自行剪枝。
        output = inputs.mul(0.0)
        return output


class ReductionBlock(nn.Module):
    def __init__(self, in_channels, out_channels):
        super().__init__()
        # 两个固定降采样残差块沿用官方主分支与池化捷径。
        self.conv_a = ReLUConvBN(in_channels, out_channels, 3, 2, 1)
        self.conv_b = ReLUConvBN(out_channels, out_channels, 3, 1, 1)
        self.downsample = nn.Sequential(
            nn.AvgPool2d(kernel_size=2, stride=2, padding=0),
            nn.Conv2d(in_channels, out_channels, 1, bias=False),
        )

    def forward(self, inputs):
        basicblock = self.conv_a(inputs)
        basicblock = self.conv_b(basicblock)
        residual = self.downsample(inputs)
        output = residual + basicblock
        return output


class Cell(nn.Module):
    def __init__(self, channels):
        super().__init__()
        # 六条边的操作在生成时固定；每条边持有独立的模块实例。
${edge_definitions}

    def forward(self, inputs):
        # 保留官方 sum(generator) 从整数 0 起步及逐项相加的执行顺序。
        node1 = 0 + self.edge_0_1(inputs)
        node2 = 0 + self.edge_0_2(inputs)
        node2 = node2 + self.edge_1_2(node1)
        node3 = 0 + self.edge_0_3(inputs)
        node3 = node3 + self.edge_1_3(node1)
        node3 = node3 + self.edge_2_3(node2)
        return node3


class NASBench201(nn.Module):
    def __init__(self):
        super().__init__()
        # 固定完整网络的 stem、三个 cell 阶段和两个降采样块。
        self.stem = nn.Sequential(
            nn.Conv2d(3, ${channels}, kernel_size=3, padding=1, bias=False),
            nn.BatchNorm2d(${channels}),
        )
        self.cells = nn.Sequential(
${network_layers}
        )
        self.lastact = nn.Sequential(
            nn.BatchNorm2d(${last_channels}),
            nn.ReLU(inplace=True),
        )
        self.global_pooling = nn.AdaptiveAvgPool2d(1)
        self.classifier = nn.Linear(${last_channels}, ${num_classes})

    def forward(self, inputs):
        feature = self.stem(inputs)
        feature = self.cells(feature)
        output = self.lastact(feature)
        output = self.global_pooling(output)
        output = output.view(output.size(0), -1)
        logits = self.classifier(output)
        return output, logits
